@@ -358,7 +357,20 @@
 wire [9:0]  overlay_y;
 wire [15:0] overlay_color;      // BGR5
 
-// HDMI output
+// HDMI output -> LCD に置き換え [LCD]
+assign overlay_x = 11'd0;   // nes2hdmi が駆動していた iosys(textdisp) の入力を固定
+assign overlay_y = 10'd0;
